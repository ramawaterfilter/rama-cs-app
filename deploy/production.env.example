# Reference only. Create shared/.env on Hostinger; never commit the filled file.
# Preserve the existing APP_KEY, database credentials, and mail configuration.
APP_NAME="Rama Customer Support"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://your-domain.example
LOG_CHANNEL=stack
LOG_LEVEL=warning
DB_CONNECTION=sqlite
DB_DATABASE=/home/u891711850/apps/rama-cs/shared/database/database.sqlite
# Leave unset/empty; a URL can override the shared database path.
DB_URL=
SESSION_DRIVER=database
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax
CACHE_STORE=database
# Use sync until a supervised worker or scheduled queue worker is configured.
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=local
MAIL_MAILER=log
